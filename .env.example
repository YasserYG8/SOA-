# Copy this file to .env and fill it in. Git ignores .env, so your values stay on this computer.
# Write values without quotes: quotes would become part of the value.

# Key that signs login tokens. Both services read it, so they always match.
# Leave it empty only for a quick local try: the built-in fallback key is public on GitHub.
JWT_SECRET=

# Gmail account that sends verification codes, with a 16-character app password
# from https://myaccount.google.com/apppasswords (not your normal Gmail password).
# While MAIL_USERNAME is empty, codes are printed in the users_proj console instead.
MAIL_USERNAME=
MAIL_PASSWORD=
